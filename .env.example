# Kopirajte u .env.local i popunite vrednosti.

# --- Supabase (obavezno) — Dashboard → Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesije (obavezno) — dugačak nasumičan niz, npr. `openssl rand -hex 48` ---
JWT_SECRET=

# --- Kontakt za pitanja o podacima (opciono) — prikazuje se na stranici /privatnost ---
NEXT_PUBLIC_CONTACT_EMAIL=

# --- ElevenLabs (opciono) — glas učitelja; bez ključa koristi se glas pregledača ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
# Neobavezno: model glasa (podrazumevano eleven_flash_v2_5, jezik hr — izmereno najtačniji izgovor)
ELEVENLABS_MODEL=
